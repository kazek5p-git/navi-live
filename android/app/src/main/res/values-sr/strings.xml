    <string name="tutorial_guidance_label">Ходајте уз упутство</string>
    <string name="tutorial_guidance_message">Након покретања навигације, слушајте одбројавање удаљености, упутства за скретање, упозорења за укрштање, звукове и вибрације.</string>
