    <string name="tutorial_welcome_status_title">Treoir ghearr</string>
    <string name="tutorial_welcome_status_message">Foghlaim an próiseas bunúsach: cuardaigh ceann scríbe, seiceáil an bealach, agus lean treoir ghutha siúil ansin.</string>
    <string name="tutorial_revisit_status_title">Conas Navi Live a úsáid</string>
    <string name="tutorial_revisit_status_message">Déan athbhreithniú ar an bpróiseas laethúil: cuardach, réamhamharc an bhealaigh, treoir bheo agus gníomhartha tapa.</string>
    <string name="tutorial_flow_title">Próiseas bunúsach</string>
    <string name="tutorial_search_label">Cuardaigh ceann scríbe</string>
    <string name="tutorial_search_message">Úsáid Cuardaigh ceann scríbe agus cuir seoladh nó áit isteach. Nuair a bhíonn do shuíomh ar eolas ag Navi Live, taispeántar áiteanna in aice láimhe ar dtús.</string>
    <string name="tutorial_route_label">Seiceáil an bealach</string>
    <string name="tutorial_route_message">Oscail réamhamharc an bhealaigh sula dtosaíonn tú ag siúl. Cabhraíonn liosta na dtreoracha leat cinneadh a dhéanamh an bhfuil ciall leis an mbealach.</string>
    <string name="tutorial_guidance_label">Siúil le treoir</string>
    <string name="tutorial_guidance_message">Tar éis duit an nascleanúint a thosú, éist le comhaireamh na faid, treoracha casadh, foláirimh trasrianta, fuaimeanna agus creathadh.</string>
    <string name="tutorial_tools_title">Ar an mbealach</string>
    <string name="tutorial_actions_label">Gníomhartha tapa</string>
    <string name="tutorial_actions_message">Oscail Socruithe ó aon scáileán, úsáid gníomhartha svaidhpeála suas agus síos ar áiteanna, agus croith an fón chun an treoir reatha a athdhéanamh.</string>
    <string name="tutorial_safety_label">Sábháilteacht</string>
    <string name="tutorial_safety_message">D’fhéadfadh sonraí GPS agus léarscáileanna a bheith míchruinn. Úsáid Navi Live mar thacaíocht agus seiceáil trasrianta, trácht agus do thimpeallacht i gcónaí.</string>
