    <string name="tutorial_search_label">Keresési cél</string>
    <string name="tutorial_search_message">Használja a Cél keresése lehetőséget, és írjon be egy címet vagy helyet. Ha a Navi Live számon megvan az Ön tartózkodási helye, először a közeli pontok jelennek meg.</string>
    <string name="tutorial_route_label">Ellenőrizze az útvonalat</string>
    <string name="tutorial_route_message">Séta előtt nyissa meg az útvonal előnézetét. Az utasításlista segít eldönteni, hogy az útvonalnak van-e értelme.</string>
    <string name="tutorial_guidance_label">Séta irányítással</string>
    <string name="tutorial_guidance_message">A navigáció elindítása után hallgassa meg a távolság-visszaszámlálást, a kanyarodási utasításokat, az átkelésre vonatkozó figyelmeztetéseket, a hangokat és a rezgést.</string>
